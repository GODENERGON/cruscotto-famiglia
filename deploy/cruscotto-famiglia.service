[Unit]
Description=Cruscotto Famiglia
After=network-online.target
Wants=network-online.target

[Service]
User=godener
WorkingDirectory=/home/godener/Projects/cruscotto-famiglia
Environment=PORT=8790
Environment=DB=/home/godener/Projects/cruscotto-famiglia/data/famiglia.db
# Environment=PASSWORD=cambiami
ExecStart=/usr/bin/env node --disable-warning=ExperimentalWarning server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
